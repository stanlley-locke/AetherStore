# Django Settings
DEBUG=False
SECRET_KEY=your-super-secret-key-change-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,aetherstore.com

# Database
DB_NAME=aether
DB_USER=aether
DB_PASSWORD=secure-db-password-change-me
DB_HOST=db
DB_PORT=5432

# Redis
REDIS_URL=redis://redis:6379/0

# Erasure Coding
RS_DATA_SHARDS=6
RS_PARITY_SHARDS=3

# Storage Node
NODE_ID=
NODE_PORT=8001
STORAGE_PATH=/data

# Security
DID_REGISTRY_URL=https://did.registry.example.com
HMAC_SECRET_KEY=your-hmac-secret-key

# Celery
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Monitoring
SENTRY_DSN=
PROMETHEUS_ENABLED=True

# Rate Limiting
UPLOAD_RATE_LIMIT=10/hour
DOWNLOAD_RATE_LIMIT=100/hour

# Quotas
DEFAULT_QUOTA_BYTES=10737418240